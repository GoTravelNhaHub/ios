{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "%@ · %@" : {
      "comment" : "A subheading that shows the destination of a trip, followed by a date range. The first argument is the destination of the trip. The second argument is the start date of the trip. The third argument is the end date of the trip.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@: %lld" : {
      "comment" : "A stepper that lets the user select the number of adults travelling. The value is bound to the `adults` state. The range is 1 to 10 minus the number of children.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$lld"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A day number, e.g. \"1\" for \"Monday\"",
      "isCommentAutoGenerated" : true
    },
    "• %@" : {
      "comment" : "A list of tips for using a travel booking platform.",
      "isCommentAutoGenerated" : true
    },
    "✓ %@" : {
      "comment" : "A list of bullet points that summarize the deal.",
      "isCommentAutoGenerated" : true
    },
